{
  "name": "micro-plus-editor",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.page.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "app": "vite build && cap sync",
    "desktop": "vite build && electron .",
    "desktop:dev": "ELECTRON_START_URL=http://localhost:5175 electron .",
    "desktop:install": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir -c.mac.notarize=false && rm -rf \"/Applications/Micro Plus.app\" && cp -R \"release/mac-arm64/Micro Plus.app\" /Applications/",
    "desktop:release": "vite build && set -a && { [ ! -f .env.local ] || . ./.env.local; } && set +a && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.0.0",
    "@types/web-bluetooth": "0.0.22",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@fontsource-variable/archivo": "5.3.0",
    "@mnlphlp/plugin-blec": "0.19.0",
    "@tauri-apps/api": "2.12.4"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "io.github.jonasjancarik.microplus.desktop",
    "productName": "Micro Plus",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Micro Plus uses Bluetooth to talk to your Mustang Micro Plus amp."
      },
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "notarize": true,
      "artifactName": "Micro-Plus-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
